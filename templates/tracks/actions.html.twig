<a id="play-track" class="btn shadow-none border-0" hx-boost="true" hx-push-url="false" href="{{ uri("player.play", [hash]) }}" hx-swap="none"><i class="bi bi-play-circle-fill"></i></a>
<span hx-get="{{ uri("track.like", [hash]) }}" hx-trigger="load, like-{{ hash }} from:body"></span>
<button onclick="copyClipboard(event)" class="share btn shadow-none border-0"><i class="bi bi-share-fill"></i></button>
