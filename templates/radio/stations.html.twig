{# The section bar renders before the grid is fetched, so its count comes back
   out-of-band with the rows. Anything that re-renders the grid re-renders this,
   so it cannot drift. #}
<span class="count" id="radio-count" hx-swap-oob="true">{{ total }} station{{ total == 1 ? '' : 's' }}</span>
{% if groups %}
  {# One heading per country, liked stations first. The filter in the section
     bar hides cards by their data-search, then any group it leaves empty. #}
  {% for g in groups %}
    <div class="station-group mb-4">
      <h2 class="mb-2">
        <i class="bi {{ g.liked ? 'bi-heart-fill text-danger' : 'bi-globe2 text-warning' }} pe-1"></i> {{ g.name }}
        <span class="group-count">{{ g.stations|length }}</span>
      </h2>
      <div class="card-grid station-grid">
        {% for s in g.stations %}
          {% include 'components/radio-card.html.twig' %}
        {% endfor %}
      </div>
    </div>
  {% endfor %}
  <p class="lead d-none" id="radio-no-match"><i class="bi bi-info pe-1 text-warning"></i> No stations match</p>
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No radio stations have been added yet</p>
{% endif %}
