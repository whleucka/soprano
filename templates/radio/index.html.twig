{% extends "layout/app.html.twig" %}

{% block title %}Soprano - Radio {% endblock %}

{% block view %}
<section id="radio" class="h-100 d-flex flex-column">
  <div class="section-bar">
    <span class="ico"><i class="bi bi-broadcast"></i></span>
    <h1 class="name">Radio</h1>
    <span class="leader" aria-hidden="true"></span>
    {# Filled out-of-band by radio/stations.html.twig once the grid lands. #}
    <span class="count" id="radio-count"></span>
  </div>
  <div class="stations scrollable p-3 card-grid"
       hx-get="{{ uri('radio.stations') }}"
       hx-trigger="load, radioStations from:body"></div>
</section>
{% endblock %}
