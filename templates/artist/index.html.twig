{% extends "layout/app.html.twig" %}

{% block title %}Soprano - {{ artist }} {% endblock %}

{% block view %}
<section id="artist" class="h-100 d-flex flex-column">
  <div class="hero d-flex align-items-center p-3">
    <div class="d-flex align-items-center">
      <img class="cover me-3" src="/images/no-album-art.png" />
      <div class="d-flex flex-column">
        <h1 class="artist">{{ artist }}</h1>
      </div>
    </div>
  </div>
  <div class="actions" class="d-flex">
    <button onclick="copyClipboard(event)" class="share btn shadow-none border-0"><i class="bi bi-share-fill"></i></button>
  </div>
  <div class="p-3 scrollable">
    <h2>Top Tracks</h2>
    <section id="top-tracks" class="pb-3" hx-get="{{ uri("artist.top-tracks", [artist_hash]) }}" hx-trigger="load, topTracks from:body"></section>

    <h2 class="mt-3">Discography</h2>
    <section id="discography" class="d-flex justify-content-start pb-3" hx-get="{{ uri("artist.discography", [artist_hash]) }}" hx-trigger="load"></section>
  </div>
</section>
{% endblock %}
