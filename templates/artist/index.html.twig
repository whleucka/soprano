{% extends "layout/app.html.twig" %}

{% block title %}Soprano - {{ artist }} {% endblock %}

{% block view %}
<section id="artist" class="h-100 d-flex flex-column">
  <div class="hero d-flex align-items-center p-3">
    <div class="d-flex align-items-center truncate">
      <img class="cover me-3" src="/images/no-album-art.png" />
      <div class="d-flex flex-column truncate">
        <h1 class="artist truncate">{{ artist }}</h1>
      </div>
    </div>
  </div>
  <div class="actions d-flex p-2" hx-get="{{ uri("artist.actions", [artist_hash]) }}" hx-trigger="load, artistActions from:body"></div>
  <div class="p-2 scrollable">
    <h2>Top Tracks</h2>
    <div id="top-tracks" hx-get="{{ uri("artist.top-tracks", [artist_hash]) }}" hx-trigger="load, topTracks from:body"></div>

    <h2 class="mt-3">Discography</h2>
    <div id="discography" class="d-flex justify-content-start scrollable pb-3" hx-get="{{ uri("artist.discography", [artist_hash]) }}" hx-trigger="load"></div>
  </div>
</section>
{% endblock %}
