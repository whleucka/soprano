{% if tracks %}
  {% for track in tracks %}
    {% embed 'components/track-row.html.twig' with {
      track: track,
      play_uri: uri('player.play', [track.hash]),
      rank: loop.index
    } %}
      {% block leading %}
        <span class="rank text-end me-3">#{{ rank }}</span>
        <img class="cover me-3" src="{{ track.cover }}" alt="{{ track.album }}" />
      {% endblock %}
      {% block trailing %}
        <i class="bi bi-play-fill text-success"></i>
        <span class="plays badge badge-dark text-end" title="{{ track.plays }} plays">{{ track.plays }}</span>
      {% endblock %}
      {% block menu %}
        <li><a class="dropdown-item" href="{{ uri('track.index', [track.hash]) }}"><i class="bi bi-music-note pe-1"></i> {{ track.title }}</a></li>
        <li><a class="dropdown-item" href="{{ uri('album.index', [track.album_hash]) }}"><i class="bi bi-disc pe-1"></i> {{ track.album }}</a></li>
      {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No plays recorded for this artist yet</p>
{% endif %}
