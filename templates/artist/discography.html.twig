{% if tracks %}
  {% for track in tracks %}
    {% embed 'components/album-cont.html.twig' with {
      track: track,
    } %}
    {% block extra %}
      <span title="{{ track.year }}" class="year truncate">{{ track.year }}</span>
    {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No albums found for this artist</p>
{% endif %}
