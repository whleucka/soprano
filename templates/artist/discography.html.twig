{% if tracks %}
  {% for track in tracks %}
    {% embed 'components/album-cont.html.twig' with {
      track: track,
    } %}
    {% block badge %}
      <span class="year-badge" title="{{ track.year }}">{{ track.year }}</span>
    {% endblock %}
    {% block extra %}
      <span title="{{ track.album }}" class="title truncate fw-bold mt-1">{{ track.album }}</span>
      <span title="{{ track.artist }}" class="artist small truncate"><i class="bi bi-person pe-1"></i> {{ track.artist }}</span>
    {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No albums found for this artist</p>
{% endif %}
