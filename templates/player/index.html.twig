{% block head_js %}
<script>
var player_hash = '{{ player.hash }}';
var player_type = '{{ player.type|default("track") }}';
var next_track_url = '{{ uri("player.next-track") }}';
var prev_track_url = '{{ uri("player.prev-track") }}';
var player_track = {
  title:  {{ player.title|json_encode|raw }},
  artist: {{ player.artist|json_encode|raw }},
  album:  {{ player.album|json_encode|raw }},
  cover:  {{ player.cover|json_encode|raw }},
};
</script>
<script src="/js/player.js?v=20260716a"></script>
{% endblock %}

{% if player.type == 'radio' %}
<div id="album-cover" class="d-flex align-items-center justify-content-center d-none d-md-flex" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()">
  <a class="text-decoration-none" href="{{ uri("radio.index") }}"><img src="{{ player.cover }}" class="cover ms-2 me-2"></a>
</div>
<div class="d-flex justify-content-center align-items-center" hx-get="{{ uri('radio.like', [player.hash]) }}" hx-trigger="load, like-{{ player.hash }} from:body">
  <button class="btn liked"><i class="bi bi-heart-fill"></i></button>
</div>
<div id="info" class="d-flex flex-column justify-content-center d-none d-lg-flex">
  <span class="title truncate">{{ player.title }}</span>
  <span class="artist truncate">{{ player.artist }}</span>
</div>
{% elseif player.type == 'podcast' %}
<div id="album-cover" class="d-flex align-items-center justify-content-center d-none d-md-flex" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()">
  <a class="text-decoration-none" href="{{ uri("podcasts.show", [player.hash]) }}"><img src="{{ player.cover }}" class="cover ms-2 me-2"></a>
</div>
<div class="d-flex justify-content-center align-items-center" hx-get="{{ uri('podcasts.like', [player.hash]) }}" hx-trigger="load, like-{{ player.hash }} from:body">
  <button class="btn liked"><i class="bi bi-heart-fill"></i></button>
</div>
<div id="info" class="d-flex flex-column justify-content-center d-none d-lg-flex" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()">
  <span class="title truncate">
    <a class="text-reset text-decoration-none" href="{{ uri("podcasts.show", [player.hash]) }}">{{ player.title }}</a>
  </span>
  <span class="artist truncate">{{ player.artist }}</span>
</div>
{% else %}
<div id="album-cover" class="d-flex align-items-center justify-content-center d-none d-md-flex" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()">
  <a class="text-decoration-none" href="{{ uri("album.index", [player.album_hash]) }}"><img src="{{ player.cover }}" class="cover ms-2 me-2"></a>
</div>
<div class="d-flex justify-content-center align-items-center" hx-get="{{ uri('track.like', [player.hash]) }}" hx-trigger="load, like-{{ player.hash }} from:body">
  <button class="btn liked"><i class="bi bi-heart-fill"></i></button>
</div>
<div id="info" class="d-flex flex-column justify-content-center d-none d-lg-flex" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()">
  <span class="title truncate">
    <a class="text-reset text-decoration-none" href="{{ uri("track.index", [player.hash]) }}">{{ player.title }}</a>
  </span>
  <span class="artist truncate"><a class="text-reset text-decoration-none" href="{{ uri("artist.index", [player.artist_hash]) }}">{{ player.artist }}</a></span>
</div>
{% endif %}
<div id="controls" class="d-flex justify-content-center align-items-center px-2">
  <button id="prev" onclick="prev()" hx-swap="none" class="btn border-0 shadow-none" {% if not playlist.tracks %}disabled{% endif %}><i class="bi bi-skip-start-circle"></i></button>
  <button id="play" onclick="play()" class="btn border-0 shadow-none" {% if player.src == '#' %}disabled{% endif %}><i class="bi bi-play-circle-fill"></i></button>
  <button id="next" onclick="next()" class="btn border-0 shadow-none" {% if not playlist.tracks %}disabled{% endif %}><i class="bi bi-skip-end-circle"></i></button>
</div>
<div id="playback" class="d-flex justify-content-center align-items-center flex-grow-1 px-2">
  {% if player.type == 'radio' %}
  <span class="radio-badge badge"><i class="bi bi-broadcast pe-1"></i> LIVE</span>
  {% else %}
  <div class="progress w-100" onclick="updateProgress()">
    <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
  </div>
  {% endif %}
</div>
{% if player.type == 'radio' %}
<audio data-hash="{{ player.hash }}" id="audio" data-type="radio" data-src="{{ player.src }}"></audio>
{% else %}
<audio data-hash="{{ player.hash }}" id="audio" src="{{ player.src }}"></audio>
{% endif %}
