{% extends "layout/app.html.twig" %}

{% block title %}Soprano - {{ review.year }} Wrapped{% endblock %}

{% block view %}
{% set t = review.totals %}
{% set in_progress = review.year == "now"|date("Y") %}
<section id="wrapped" class="h-100 d-flex flex-column">
  <div class="hero wrapped-hero d-flex flex-column justify-content-center p-3">
    <div class="d-flex flex-column truncate">
      <h5 class="wrapped-kicker mb-1">Your year in review</h5>
      <h1 class="wrapped-title truncate">{{ review.year }} Wrapped</h1>
      {% if t.plays > 0 %}
        <h5 class="stats">{{ t.plays|number_format }} plays &middot; {{ t.hours >= 2 ? t.hours|number_format ~ " hours" : t.minutes|number_format ~ " minutes" }} &middot; {{ t.days }} {{ t.days == 1 ? "day" : "days" }} with music</h5>
        {% if review.since %}
          <h5 class="wrapped-since mb-0">Counting from {{ review.since.date }}, when Soprano started keeping score</h5>
        {% endif %}
        <div class="actions d-flex flex-nowrap align-items-center gap-2 mt-3">
          <a class="btn btn-sm wrapped-play" title="Play your top tracks of {{ review.year }}"
             hx-boost="true" hx-push-url="false" hx-swap="none"
             href="{{ uri('player.play-wrapped', [review.year]) }}">
            <i class="bi bi-play-circle-fill"></i>
            <span>Play your top {{ min(t.tracks, constant('App\\Services\\Soprano\\WrappedService::MIX_SIZE')) }}</span>
          </a>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="wrapped-body p-3 scrollable">
    {% if t.plays == 0 %}
      <p class="lead"><i class="bi bi-stars tn-icon-purple pe-1"></i> Nothing played in {{ review.year }} yet — press play and check back.</p>
    {% else %}

      <div class="wrapped-tiles">
        <div class="wrapped-tile wrapped-reveal" style="--i: 0">
          <span class="wrapped-num">{{ t.minutes|number_format }}</span>
          <span class="wrapped-label">minutes listened</span>
        </div>
        <div class="wrapped-tile wrapped-reveal" style="--i: 1">
          <span class="wrapped-num">{{ t.tracks|number_format }}</span>
          <span class="wrapped-label">different tracks</span>
        </div>
        <div class="wrapped-tile wrapped-reveal" style="--i: 2">
          <span class="wrapped-num">{{ t.artists|number_format }}</span>
          <span class="wrapped-label">artists</span>
        </div>
        <div class="wrapped-tile wrapped-reveal" style="--i: 3">
          <span class="wrapped-num">{{ t.albums|number_format }}</span>
          <span class="wrapped-label">albums</span>
        </div>
        {% if review.liked > 0 %}
          <div class="wrapped-tile wrapped-reveal" style="--i: 4">
            <span class="wrapped-num">{{ review.liked|number_format }}</span>
            <span class="wrapped-label">tracks hearted</span>
          </div>
        {% endif %}
      </div>

      {% if review.top_tracks %}
        {% set sot = review.top_tracks|first %}
        {% set tint = sot.dominant_color|default('') matches '/^#[0-9a-fA-F]{6}$/' ? sot.dominant_color : '#7aa2f7' %}
        <button type="button" class="wrapped-spotlight wrapped-reveal mt-4" style="--i: 5; --tint: {{ tint }}"
                hx-get="{{ uri('player.play', [sot.hash]) }}?src=wrapped" hx-swap="none" title="Play {{ sot.title }}">
          <img src="{{ sot.cover }}" alt="">
          <span class="d-flex flex-column truncate">
            <span class="wrapped-kicker">Your song of the year</span>
            <span class="wrapped-spotlight-title truncate">{{ sot.title }}</span>
            <span class="wrapped-spotlight-artist truncate">{{ sot.artist }}</span>
            <span class="wrapped-spotlight-plays">{{ sot.plays|number_format }} plays</span>
          </span>
          <i class="bi bi-play-circle-fill wrapped-spotlight-play"></i>
        </button>
      {% endif %}

      <div class="wrapped-callouts mt-3" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
        {% if review.obsession %}
          <a class="wrapped-callout wrapped-reveal" style="--i: 6" href="{{ uri('artist.index', [review.obsession.hash]) }}">
            <i class="bi bi-fire tn-icon-orange"></i>
            <span>Your {{ review.obsession.month }} obsession was <b>{{ review.obsession.artist }}</b> — {{ review.obsession.plays|number_format }} plays in one month.</span>
          </a>
        {% endif %}
        {% if review.daypart %}
          <div class="wrapped-callout wrapped-reveal" style="--i: 7">
            <i class="bi {{ review.daypart.icon }} tn-icon-yellow"></i>
            <span>You're a <b>{{ review.daypart.label }}</b>. {{ review.daypart.blurb }} — {{ review.daypart.share }}% of your plays. Busiest hour: {{ review.daypart.peak_hour }}.</span>
          </div>
        {% endif %}
        {% if review.streak %}
          <div class="wrapped-callout wrapped-reveal" style="--i: 8">
            <i class="bi bi-lightning-charge-fill tn-icon-green"></i>
            <span>Longest streak: <b>{{ review.streak.days }} days</b> in a row with music, {{ review.streak.from }} – {{ review.streak.to }}.</span>
          </div>
        {% endif %}
        {% if review.peak_day %}
          <div class="wrapped-callout wrapped-reveal" style="--i: 9">
            <i class="bi bi-calendar-heart tn-icon-red"></i>
            <span>Biggest day: <b>{{ review.peak_day.date }}</b>, with {{ review.peak_day.plays|number_format }} plays.</span>
          </div>
        {% endif %}
      </div>

      {% if review.top_artists %}
        <h2 class="mt-5"><i class="bi bi-person-hearts tn-icon-purple pe-1"></i> Top Artists</h2>
        <div class="wrapped-artists py-2" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
          {% for a in review.top_artists %}
            <a class="wrapped-artist{{ loop.first ? ' is-top' : '' }}" href="{{ uri('artist.index', [a.hash]) }}">
              <span class="wrapped-rank">{{ loop.index }}</span>
              <img src="{{ a.image|default('/images/no-album-art.png') }}" alt="" loading="lazy">
              <span class="wrapped-artist-name truncate" title="{{ a.name }}">{{ a.name }}</span>
              <span class="wrapped-plays">{{ a.plays|number_format }} plays</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}

      {% if review.top_tracks %}
        <h2 class="mt-5"><i class="bi bi-star-fill tn-icon-yellow pe-1"></i> Top Tracks</h2>
        {% set tmax = (review.top_tracks|first).plays %}
        <div class="wrapped-tracks py-2">
          {% for tr in review.top_tracks %}
            <button type="button" class="wrapped-track" hx-get="{{ uri('player.play', [tr.hash]) }}?src=wrapped" hx-swap="none" title="Play {{ tr.title }}">
              <span class="wrapped-rank">{{ loop.index }}</span>
              <img src="{{ tr.cover }}" alt="" loading="lazy">
              <span class="d-flex flex-column truncate">
                <span class="title truncate">{{ tr.title }}</span>
                <span class="artist small truncate">{{ tr.artist }}</span>
              </span>
              <span class="wrapped-track-meter ms-auto" aria-hidden="true"><span style="width: {{ (tr.plays / tmax * 100)|round }}%"></span></span>
              <span class="wrapped-plays">{{ tr.plays|number_format }} plays</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}

      {% if review.top_albums %}
        <h2 class="mt-5"><i class="bi bi-disc tn-icon-cyan pe-1"></i> Top Albums</h2>
        <div class="wrapped-albums py-2" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
          {% for al in review.top_albums %}
            <a class="wrapped-album" href="{{ uri('album.index', [al.hash]) }}">
              <img src="{{ al.cover|default('/images/no-album-art.png') }}" alt="" loading="lazy">
              <span class="title truncate" title="{{ al.title }}">{{ al.title }}</span>
              <span class="artist small truncate">{{ al.artist }} &middot; {{ al.plays|number_format }} plays</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}

      {% if review.top_genres %}
        <h2 class="mt-5"><i class="bi bi-vinyl-fill tn-icon-green pe-1"></i> Top Genres</h2>
        {% set gmax = (review.top_genres|first).plays %}
        <div class="wrapped-genres py-2">
          {% for g in review.top_genres %}
            <div class="wrapped-genre">
              <span class="wrapped-genre-name truncate">{{ g.genre }}</span>
              <span class="wrapped-genre-bar"><span style="width: {{ (g.plays / gmax * 100)|round }}%"></span></span>
              <span class="wrapped-plays">{{ g.plays|number_format }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <h2 class="mt-5"><i class="bi bi-bar-chart-fill tn-icon-blue pe-1"></i> Month by Month</h2>
      <div class="wrapped-chart py-2" role="img" aria-label="Plays per month{% for m in review.by_month %}, {{ m.month }} {{ m.plays }}{% endfor %}">
        {% for m in review.by_month %}
          {% set peak = m.plays > 0 and m.plays == review.by_month_max %}
          <div class="wrapped-bar{{ peak ? ' is-peak' : '' }}" title="{{ m.month }}: {{ m.plays|number_format }} plays" style="--i: {{ loop.index0 }}">
            {% if peak %}<span class="wrapped-bar-value">{{ m.plays|number_format }}</span>{% endif %}
            <span class="wrapped-bar-fill" style="--h: {{ (m.plays / review.by_month_max * 100)|round }}"></span>
            <span class="wrapped-bar-label">{{ m.month|slice(0, 3) }}</span>
          </div>
        {% endfor %}
      </div>

      <h2 class="mt-5"><i class="bi bi-clock-history tn-icon-orange pe-1"></i> Listening Clock</h2>
      <div class="wrapped-chart wrapped-clock py-2" role="img" aria-label="Plays by hour of day{% if review.daypart %}, busiest around {{ review.daypart.peak_hour }}{% endif %}">
        {% for plays in review.by_hour %}
          {% set h = loop.index0 %}
          {% set peak = plays > 0 and plays == review.by_hour_max %}
          <div class="wrapped-bar{{ peak ? ' is-peak' : '' }}" title="{{ '%02d'|format(h) }}:00 — {{ plays|number_format }} plays" style="--i: {{ h }}">
            <span class="wrapped-bar-fill" style="--h: {{ (plays / review.by_hour_max * 100)|round }}"></span>
            <span class="wrapped-bar-label">{{ h % 6 == 0 ? ((h % 12 == 0 ? 12 : h % 12) ~ (h < 12 ? 'a' : 'p')) : '' }}</span>
          </div>
        {% endfor %}
      </div>

      <p class="wrapped-footnote mt-5 mb-0">
        Skipped tracks don't count as plays, but the time you spent on them still counts toward minutes listened.
        {% if in_progress %}Your {{ review.year }} keeps counting until December 31.{% endif %}
      </p>

    {% endif %}
  </div>
</section>
{% endblock %}
