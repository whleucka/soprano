{% extends "layout/app.html.twig" %}

{% block title %}Soprano - {{ name }} {% endblock %}

{% block view %}
<section id="playlist-view" class="h-100">
  <div class="hero d-flex align-items-center p-3"{% if dominant %} style="background: linear-gradient(180deg, rgba({{ dominant[0] }}, {{ dominant[1] }}, {{ dominant[2] }}, 0.5) 0%, rgba(0, 0, 0, 0) 100%);"{% endif %}>
    <div class="d-flex align-items-center truncate">
      <img class="cover me-3" src="{{ cover }}" />
      <div class="d-flex flex-column truncate">
        <h5 class="year"><i class="bi bi-music-note-list pe-1"></i> Playlist</h5>
        <h1 title="{{ name }}" class="album truncate">{{ name }}</h1>
        <h3 class="artist">{{ count }} track{% if count != 1 %}s{% endif %}</h3>
      </div>
    </div>
  </div>
  <div class="actions align-items-center d-flex p-2" hx-get="{{ uri("playlists.actions", [hash]) }}" hx-trigger="load, playlistActions from:body"></div>
  <div class="tracks scrollable" hx-get="{{ uri('playlists.tracks', [hash]) }}" hx-trigger="load, playlistTracks-{{ hash }} from:body"></div>
</section>
{% endblock %}
