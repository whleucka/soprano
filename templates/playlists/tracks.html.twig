{% if tracks %}
  {% for track in tracks %}
    {% embed 'components/track-row.html.twig' with {
      track: track,
      player: player,
      play_uri: uri('player.play-collection-track', [hash, loop.index0])
    } %}
      {% block leading %}
        <img title="{{ track.album }}" class="cover me-2" src="{{ track.cover }}" loading="lazy"/>
      {% endblock %}
      {% block menu %}
        <li><a class="dropdown-item" href="{{ uri('track.index', [track.hash]) }}"><i class="bi bi-music-note pe-1"></i> {{ track.title }}</a></li>
        <li><a class="dropdown-item" href="{{ uri('artist.index', [track.artist_hash]) }}"><i class="bi bi-person pe-1"></i> {{ track.artist }}</a></li>
        <li><a class="dropdown-item" href="{{ uri('album.index', [track.album_hash]) }}"><i class="bi bi-disc pe-1"></i> {{ track.album }}</a></li>
        {% if is_liked|default(false) %}
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" hx-get="{{ uri('track.like-toggle', [track.hash]) }}" hx-swap="none"><i class="bi bi-heartbreak pe-1"></i> Remove from Liked</a></li>
        {% elseif not is_virtual|default(false) %}
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" hx-get="{{ uri('playlists.remove-track', [hash, track.hash]) }}" hx-swap="none"><i class="bi bi-trash3 pe-1"></i> Remove from playlist</a></li>
        {% endif %}
      {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <p class="lead p-3"><i class="bi bi-info pe-1 text-warning"></i> This playlist is empty.</p>
{% endif %}
