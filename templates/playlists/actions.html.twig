<a id="play-playlist" class="btn btn-sm btn-outline-light" title="Play" hx-boost="true" hx-push-url="false" href="{{ uri("player.play-collection", [hash]) }}" hx-swap="none"><i class="bi bi-play-circle-fill"></i></a>
<button onclick="copyClipboard(event)" class="share btn btn-sm btn-outline-light" title="Share"><i class="bi bi-share-fill"></i></button>
{# Rename and delete are for the client's own playlists only: a virtual one has no row behind it, and a generated mix is the nightly job's — it owns the name and rebuilds the slot, so deleting it only buys a new hash. #}
{% if not is_virtual|default(false) and not is_generated|default(false) %}
<button class="btn btn-sm btn-outline-light" title="Rename playlist" data-bs-toggle="modal" data-bs-target="#modal" hx-get="{{ uri('playlists.rename-form', [hash]) }}" hx-target="#modal .modal-content" hx-swap="innerHTML" hx-select="#modal-rename"><i class="bi bi-pencil"></i></button>
<button class="btn btn-sm btn-outline-light" title="Delete playlist" hx-get="{{ uri('playlists.delete', [hash]) }}" hx-swap="none" hx-confirm="Delete the playlist &quot;{{ name }}&quot;?"><i class="bi bi-trash3"></i></button>{% endif %}
