<a id="play-playlist" class="btn shadow-none border-0" hx-boost="true" hx-push-url="false" href="{{ uri("player.play-collection", [hash]) }}" hx-swap="none"><i class="bi bi-play-circle-fill"></i></a>
<button onclick="copyClipboard(event)" class="share btn shadow-none border-0"><i class="bi bi-share-fill"></i></button>
<button class="btn shadow-none border-0" hx-get="{{ uri('playlists.delete', [hash]) }}" hx-swap="none" hx-confirm="Delete the playlist &quot;{{ name }}&quot;?"><i class="bi bi-trash3"></i></button>
