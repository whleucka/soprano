{% block head_js %}
<script src="/js/playlist.js?v=20260531v2"></script>
{% endblock %}

<div class="d-flex flex-column align-content-start h-100" style="min-height: 0;">
  <div id="now-playing" class="d-flex flex-column p-2" hx-get="{{ uri('playlist.now-playing') }}" hx-trigger="load, nowPlaying from:body"></div>
  <div class="actions d-flex px-2" hx-get="{{ uri('playlist.actions') }}" hx-trigger="load, playlistActions from:body"></div>
  <div class="tracks scrollable mt-2" hx-get="{{ uri('playlist.queue') }}" hx-trigger="load, playlistQueue from:body"></div>
</div>
