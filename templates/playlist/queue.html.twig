<div class="p-2">
  <div id="tracks">
    {% if playlist.tracks %}
      {% for track in playlist.tracks %}
      <div id="playlist-{{ track.hash }}" tabindex="-1" class="track mb-2{% if player.hash == track.hash %}active{% endif %} d-flex align-items-center shadow-none border-0" hx-get="{{ uri("player.play-playlist-track", [loop.index0]) }}" hx-swap="none">
        <div class="d-flex flex-column flex-grow-1 truncate">
          <span class="title truncate {% if player.hash == track.hash %}active{% endif %}">{{ track.title}}</span>
          <span class="artist truncate {% if player.hash == track.hash %}active{% endif %}">{{ track.artist}}</span>
        </div>
        <span class="playtime-string">{{ track.playtime_string }}</span>
      </div>
      {% endfor %}
    {% else %}
      <p class="lead text-secondary fst-italic">Playlist is empty</p>
    {% endif %}
  </div>
</div>
