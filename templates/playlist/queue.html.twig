{% if playlist.tracks %}
  {% for track in playlist.tracks %}
    {% embed 'components/track-row.html.twig' with {
      track: track,
      play_uri: uri('player.play-playlist-track', [loop.index0]),
      dom_id: track.hash,
      active: current.hash == track.hash,
      dropdown_suffix: 'queue-dropdown',
      row_before_request: 'hidePlaylist()',
    } %}
      {% block leading %}
        <img title="{{ track.album }}" class="cover me-2" src="{{ track.cover }}" loading="lazy"/>
      {% endblock %}
      {% block queue_actions %}
        <li><a class="dropdown-item" style="cursor: pointer;" hx-get="{{ uri('playlist.queue-remove', [track.hash]) }}" hx-swap="none"><i class="bi bi-x-lg pe-1"></i> Remove from queue</a></li>
      {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <div class="p-2">
      <p class="lead"><i class="bi bi-info text-warning pe-1"></i> Playlist is empty</p>
  </div>
{% endif %}
