{% if playlist.tracks %}
  {% for track in playlist.tracks %}
    <div id="{{ track.hash }}" tabindex="-1" class="track mb-2 px-1 {% if player.hash == track.hash %}active{% endif %} d-flex align-items-center justify-content-center shadow-none border-0">
      <div class="d-flex align-items-center flex-grow-1 truncate" hx-get="{{ uri("player.play-playlist-track", [loop.index0]) }}" hx-swap="none">
        <div class="d-flex flex-column flex-grow-1 truncate">
          <span title="{{ track.title }}" class="title truncate">{{ track.title}}</span>
          <span title="{{ track.artist }}" class="artist small truncate">{{ track.artist}}</span>
        </div>
      </div>
      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" id="{{ track.hash }}-queue-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
          <span class="playtime-string">{{ track.playtime_string }}</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="{{ track.hash }}-queue-dropdown" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="togglePlaylist()">
          <li><a class="dropdown-item" href="{{ uri("artist.index", [track.artist_hash]) }}">{{ track.artist }}</a></li>
          <li><a class="dropdown-item" href="{{ uri("album.index", [track.album_hash]) }}">{{ track.album }}</a></li>
        </ul>
      </div>
    </div>
  {% endfor %}
{% else %}
  <div class="p-2">
      <p class="lead"><i class="bi bi-info text-warning pe-1"></i> Playlist is empty</p>
  </div>
{% endif %}
