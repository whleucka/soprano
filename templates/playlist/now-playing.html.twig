<div class="d-flex flex-column px-2" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()">
  <div class="d-flex align-items-center">
    <a class="text-reset text-decoration-none" href="{{ uri("album.index", [current.album_hash]) }}"><img class="cover" src="{{ current.cover }}" /></a>
    <div class="d-flex flex-column truncate p-2 mt-2 ms-2">
      <h1 class="title m-0 mb-2 truncate"><a class="text-reset text-decoration-none" href="{{ uri("track.index", [current.hash]) }}">{{ current.title }}</a></h1>
      <h3 class="artist truncate"><a class="text-reset text-decoration-none" href="{{ uri("artist.index", [current.artist_hash]) }}">{{ current.artist }}</a></h3>
      <h3 class="album truncate"><a class="text-reset text-decoration-none" href="{{ uri("album.index", [current.album_hash]) }}">{{ current.album }}</a></h3>
    </div>
  </div>
</div>
<script>
(function() {
  document.getElementById('now-playing').style.background = "linear-gradient(180deg, rgba({{ dominant[0] }}, {{ dominant[1] }}, {{ dominant[2] }}, 0.5) 0%, rgba(0, 0, 0, 0) 100%)";
  updateActiveTrack('{{ current.hash }}');
})();
</script>
