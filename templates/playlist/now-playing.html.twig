<div class="d-flex align-items-center px-2">
  <img class="cover" src="{{ current.cover }}" />
  <div class="d-flex flex-column truncate p-2 mt-2 ms-2" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()">
    <h1 class="title m-0 mb-2 truncate">{{ current.title }}</h1>
    <h3 class="artist truncate"><a class="text-reset text-decoration-none" href="{{ uri("artist.index", [current.artist_hash]) }}"><i class="bi bi-person pe-1"></i> {{ current.artist }}</a></h3>
    <h3 class="album truncate"><a class="text-reset text-decoration-none" href="{{ uri("album.index", [current.album_hash]) }}"><i class="bi bi-disc pe-1"></i> {{ current.album }}</a></h3>
  </div>
</div>
<script>
(function() {
  document.getElementById('now-playing').style.background = "linear-gradient(180deg, rgba({{ dominant[0] }}, {{ dominant[1] }}, {{ dominant[2] }}, 0.5) 0%, rgba(0, 0, 0, 0) 100%)";
  updateActiveTrack('{{ current.hash }}');
})();
</script>
