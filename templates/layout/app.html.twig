{% extends "layout/base.html.twig" %}

{% block head_css %}
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/bootstrap-icons/bootstrap-icons.min.css">
{% endblock %}

{% block content %}
  <main id="app" class="h-100" hx-indicator=".hx-indicator">
    <div class="d-flex flex-column h-100">
      <div class="d-flex flex-grow-1">
        <section id="sidebar">
          <div class="content h-100">
            <div class="p-2">
              <h1><i class="bi bi-music-note-beamed pe-1"></i> Soprano</h1>

              <h2 class="mt-3">Menu</h2>
              <nav class="nav flex-column">
                <a class="nav-link" href="/home"><i class="bi bi-house pe-1"></i> Home</a>
                <a class="nav-link" href="/tracks"><i class="bi bi-music-note pe-1"></i> Tracks</a>
                <a class="nav-link" href="/radio"><i class="bi bi-broadcast pe-1"></i> Radio</a>
                <a class="nav-link" href="/podcasts"><i class="bi bi-mic pe-1"></i> Podcasts</a>
                <a class="nav-link" href="/tv"><i class="bi bi-tv pe-1"></i> TV</a>
                <a class="nav-link" href="/movies"><i class="bi bi-film pe-1"></i> Movies</a>
              </nav>

              <h2 class="mt-4">Playlists</h2>
              <nav class="nav flex-column">
                <a class="nav-link disabled" href="#">No playlists yet</a>
              </nav>
            </div>
          </div>
        </section> 
        <div class="d-flex flex-column flex-grow-1">
          <div id="top-search" class="d-flex align-items-center p-1">
            <div class="input-group">
              <input type="search" class="form-control border-0 shadow-none p-3" placeholder="What do you want to play?" />
              <button class="btn border-0"><i class='bi bi-search'></i></button>
            </div>
            <div class="dropdown">
              <button class="btn dropdown-toggle border-0 shadow-none" type="button" id="menu-button" data-bs-toggle="dropdown" aria-expanded="false">
                <img id="profile-icon" src="/images/profile.png" />
              </button>
              <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="menu-button">
                <li><a class="dropdown-item" href="#">N/A</a></li>
              </ul>
            </div>
          </div>
          <div class="d-flex flex-grow-1">
            <section id="view" class="flex-grow-1">
              <div class="content h-100">
                {% block view %}{% endblock %}
              </div>
            </section>
            <section id="playlist" class="d-none d-xl-block">
              <div class="content h-100">
                <div class="p-2">
                  <div>One</div>
                  <div>Two</div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
      <section id="player" class="d-flex">
        <div id="info">
        </div>
        <div id="controls">
        </div>
        <div id="playback"">
        </div>
        <div id="volume"">
        </div>
      </section>
    </div>
  </main>
{% endblock %}
