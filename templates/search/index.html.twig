{% extends "layout/app.html.twig" %}

{% block title %}Soprano - Search {% endblock %}

{% block view %}
<section id="search" class="h-100 d-flex flex-column">
  {# Rendered inline rather than fetched on load: this template only ever
     renders as a whole page, so the state is already here, and on a feed link
     the heading is the point of the page — fetching it flashes a bare hero
     first. The hx-get is only for the in-place refresh after a clear. #}
  <div class="hero d-flex flex-column justify-content-center p-3" hx-get="{{ uri("search.hero") }}" hx-trigger="searchHero from:body">
    {% include 'search/hero.html.twig' %}
  </div>
  <div class="tracks scrollable" hx-get="{{ uri('search.results') }}" hx-trigger="load, searchResults from:body">
    {# Only the track-result path is slow enough to need a placeholder, and only
       it renders rows. Genre/decade/feed entry points set results with no term,
       so key off the rows themselves; with nothing to render the load resolves
       to the browse grid and we leave it empty rather than flash mismatched
       track-row skeletons. #}
    {% if search.term|default('') or search.tracks|default([]) %}{% include 'components/skeleton-rows.html.twig' with { cover: true, meta: search.context|default(null) is not null } %}{% endif %}
  </div>
</section>
{% endblock %}
