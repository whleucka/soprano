{% extends "layout/app.html.twig" %}

{% block title %}Soprano - Search {% endblock %}

{% block view %}
<section id="search" class="h-100">
  <div class="hero d-flex align-items-center p-3">
    <div class="d-flex align-items-center">
      <div class="d-flex flex-column">
        <h1 class="title"><i class="bi bi-search pe-1"></i> Search</h1>
      </div>
    </div>
  </div>
  <div id="actions" class="d-flex">
  </div>
  <div id="tracks" class="scrollable">
    {% if search.tracks %}
      {% for track in search.tracks %}
      <div id="search-{{ track.hash }}" tabindex="-1" class="track py-2 px-1 {% if player.hash == track.hash %}active{% endif %} d-flex align-items-center justify-content-center shadow-none border-0" hx-get="{{ uri("player.play", [track.hash]) }}" hx-swap="none">
        <img title="{{ track.album }}" class="cover me-2" src="{{ track.cover }}" />
        <div class="d-flex flex-column flex-grow-1 truncate" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
          <span title="{{ track.title }}" class="title truncate {% if player.hash == track.hash %}active{% endif %}">{{ track.title}}</span>
          <span title="{{ track.album }}" class="album truncate {% if player.hash == track.hash %}active{% endif %}"><a class="text-decoration-none" href="{{ uri("music.album", [track.hash]) }}"><i class="bi bi-person pe-1"></i>{{ track.album}}</a></span>
          <span title="{{ track.artist }}" class="artist truncate {% if player.hash == track.hash %}active{% endif %}"><a class="text-decoration-none" href="{{ uri("music.artist", [track.hash]) }}"><i class="bi bi-disc pe-1"></i>{{ track.artist}}</a></span>
        </div>
        <span class="playtime-string pe-2">{{ track.playtime_string }}</span>
      </div>
      {% endfor %}
    {% else %}
      <div class="p-2">
        {% if search.term %}
          <p class="lead"><i class="bi bi-info text-warning pe-1"></i> No results found for '{{ search.term }}'</p>
        {% else %}
          <p class="lead"><i class="bi bi-star-fill text-warning pe-1"></i> Search for tracks, albums, and artists!</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}
