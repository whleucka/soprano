{% extends "layout/app.html.twig" %}

{% block title %}Soprano - Search {% endblock %}

{% block view %}
<section id="search" class="h-100 d-flex flex-column">
  <div class="hero d-flex flex-column justify-content-center p-3">
    <h1 class="title"><i class="bi bi-search pe-1"></i> Search</h1>
    <div class="actions d-flex flex-nowrap align-items-center gap-2 mt-2" hx-get="{{ uri("search.actions") }}" hx-trigger="load, searchActions from:body"></div>
  </div>
  <div class="tracks scrollable" hx-get="{{ uri('search.results') }}" hx-trigger="load, searchResults from:body">
    {# Only the track-result path is slow enough to need a placeholder, and only
       it renders rows. Genre/decade/feed entry points set results with no term,
       so key off the rows themselves; with nothing to render the load resolves
       to the browse grid and we leave it empty rather than flash mismatched
       track-row skeletons. #}
    {% if search.term|default('') or search.tracks|default([]) %}{% include 'components/skeleton-rows.html.twig' with { cover: true } %}{% endif %}
  </div>
</section>
{% endblock %}
