<form class="w-100" hx-get="{{ uri("search.index") }}" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-on::before-request="hidePlaylist()" hx-push-url="true">
  <div class="input-group">
    <input type="text" class="form-control border-0 shadow-none p-3" name="term" value="{{ search.term }}" placeholder="What do you want to play?" />
    {% if search.term %}
      <button type="button" class="btn border-0" hx-get="{{ uri('search.clear') }}" hx-swap="none" hx-push-url="{{ uri("search.index") }}"><i class='bi bi-trash'></i></button>
    {% endif %}
  </div>
</form>
<div class="dropdown ms-1">
  <button class="btn dropdown-toggle border-0 shadow-none" type="button" id="menu-button" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="bi bi-person-circle"></i>
  </button>
  <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="menu-button" hx-on::before-request="hidePlaylist()" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
    <li class="d-block d-md-none"><a class="dropdown-item" href="{{ uri("home.index") }}"><i class="bi bi-house pe-1"></i> Home</a></li>
    <li class="d-block d-md-none"><a class="dropdown-item" href="{{ uri("search.index") }}"><i class="bi bi-search pe-1"></i> Search</a></li>
    <li class="d-block d-md-none"><a class="dropdown-item" href="{{ uri("radio.index") }}"><i class="bi bi-broadcast pe-1"></i> Radio</a></li>
    <li class="d-block d-md-none"><a class="dropdown-item" href="{{ uri("podcasts.index") }}"><i class="bi bi-mic pe-1"></i> Podcasts</a></li>
    <li class="d-block d-md-none"><a class="dropdown-item" href="{{ uri("playlists.index") }}"><i class="bi bi-music-note-list pe-1"></i> Playlists</a></li>
    <li class="d-block d-md-none"><a class="dropdown-item" href="{{ uri("playlists.show", ["liked"]) }}"><i class="bi bi-heart-fill pe-1"></i> Liked</a></li>

    <li class="d-block"><a class="dropdown-item" href="{{ uri("profile.index") }}"><i class="bi bi-person pe-1"></i> Profile</a></li>
    {% if client.is_admin %}
      {# hx-boost="false": see the sidebar. This menu boosts into #view and the
         admin layout has its own #view, so a boosted /admin swaps the backend
         into the player instead of leaving it. #}
      <li class="d-block"><a class="dropdown-item" hx-boost="false" href="{{ uri("admin.root") }}"><i class="bi bi-shield-check pe-1"></i> Admin</a></li>
    {% endif %}
    <li><hr class="dropdown-divider"></li>
    <li class="d-block">
      <form method="POST" action="{{ uri('client.auth.sign-out.post') }}" hx-post="{{ uri('client.auth.sign-out.post') }}" hx-target="this" hx-swap="none" class="m-0">
        {{ csrf()|raw }}
        <button type="submit" class="dropdown-item text-start border-0 bg-transparent"><i class="bi bi-box-arrow-right me-1"></i> Sign Out</button>
      </form>
    </li>
  </ul>
</div>
<div class="d-flex justify-content-center align-items-center">
  <button id="show-playlist" class="btn border-0 shadow-none" type="button" title="Queue"
          aria-label="Queue" aria-pressed="false" aria-controls="playlist"
          onclick="togglePlaylist();"><i class="bi bi-list-ol"></i></button>
</div>
