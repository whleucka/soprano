<div class="browse p-2">
  {% if genres %}
    <h2 class="browse-heading"><i class="bi bi-grid-1x2-fill text-info pe-1"></i> Browse Genres</h2>
    <div class="browse-grid" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-boost="true" hx-push-url="true">
      {% for g in genres %}
        <a class="browse-tile" href="{{ uri('search.genre') }}?genre={{ g.genre|url_encode }}" style="--tile-color: {{ g.color ?? '#5b5b5b' }}">
          <span class="browse-tile-title truncate" title="{{ g.genre }}">{{ g.genre }}</span>
          <span class="browse-tile-count">{{ g.count }} album{{ g.count == 1 ? '' : 's' }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {% if decades %}
    <h2 class="browse-heading mt-4"><i class="bi bi-calendar3 text-warning pe-1"></i> Browse Decades</h2>
    <div class="browse-grid" hx-target="#view" hx-select="#view" hx-swap="outerHTML" hx-boost="true" hx-push-url="true">
      {% for d in decades %}
        <a class="browse-tile" href="{{ uri('search.decade') }}?decade={{ d.decade }}" style="--tile-color: {{ d.color ?? '#5b5b5b' }}">
          <span class="browse-tile-title">{{ d.decade }}s</span>
          <span class="browse-tile-count">{{ d.count }} album{{ d.count == 1 ? '' : 's' }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {% if not genres and not decades %}
    <p class="lead"><i class="bi bi-star-fill text-warning pe-1"></i> Search for tracks, albums, and artists!</p>
  {% endif %}
</div>
