{% if search.tracks %}
<button class="btn btn-sm btn-dark me-2" hx-get="{{ uri("player.play-search") }}" hx-swap="none"><i class="bi bi-play-fill text-success"></i></button>
<button class="btn btn-sm btn-dark" hx-get="{{ uri("search.clear") }}"><i class="bi bi-trash text-danger"></i></button>
{% endif %}
