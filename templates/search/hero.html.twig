{# Title + count + actions for the search view. All three read the same session
   state, so they re-render together — see SearchController::hero(). These are
   the contents of the section bar in search/index.html.twig, not a block of
   their own: the row's no-wrap behaviour depends on .leader being the only
   child that grows, so nothing here may be given flex-grow. #}
{% set ctx = search.context|default(null) %}
{% set count = search.tracks|default([])|length %}
<span class="ico {{ ctx ? ctx.color|default('') : '' }}"><i class="bi {{ ctx ? ctx.icon : 'bi-search' }}"></i></span>
<h1 class="name">{{ ctx ? ctx.label : 'Search' }}</h1>
{# The leader takes the context's colour when there is one — bootstrap's text-*
   utilities are !important, so they win over the section hue — which keeps the
   icon and the leader matched as the feed changes. #}
<span class="leader {{ ctx ? ctx.color|default('') : '' }}" aria-hidden="true"></span>
<span class="count">{% if ctx %}{{ count }} track{{ count == 1 ? '' : 's' }}{% if ctx.note|default(null) %} &middot; {{ ctx.note }}{% endif %}{% endif %}</span>
{% if search.tracks %}
  <span class="controls">
    <button class="btn btn-sm btn-outline-light" title="Play results" hx-get="{{ uri("player.play-search") }}" hx-swap="none"><i class="bi bi-play-fill text-success"></i></button>
    <button class="btn btn-sm btn-outline-light" title="Add to playlist" data-bs-toggle="modal" data-bs-target="#modal"
            hx-get="{{ uri('playlists.modal') }}?src=search" hx-target="#modal .modal-content" hx-swap="innerHTML" hx-select="#modal-picker"><i class="bi bi-music-note-list"></i></button>
    <button class="btn btn-sm btn-outline-light" title="Clear search" hx-get="{{ uri("search.clear") }}" hx-swap="none"><i class="bi bi-trash text-danger"></i></button>
  </span>
{% endif %}
