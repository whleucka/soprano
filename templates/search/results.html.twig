{% if search.tracks %}
  {% for track in search.tracks %}
    {% embed 'components/track-row.html.twig' with {
      track: track,
      play_uri: uri('player.play', [track.hash]) ~ '?src=search'
    } %}
      {% block leading %}
        <img title="{{ track.album }}" class="cover me-2" src="{{ track.cover }}" loading="lazy"/>
      {% endblock %}
      {# The feed views are the flat version of a home rail, and the rail card
         carried the fact that put the track in the list — who played it, how
         many times, when it was liked. Without this line the "More" click
         trades all of it for a longer list. #}
      {% block meta %}{% include 'components/track-meta.html.twig' %}{% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  {% if search.term %}
    <div class="p-2">
      <p class="lead"><i class="bi bi-info text-warning pe-1"></i> No results found for '{{ search.term }}'</p>
    </div>
  {% else %}
    <div hx-get="{{ uri('search.browse') }}" hx-trigger="load"></div>
  {% endif %}
{% endif %}
