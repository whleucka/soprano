{% if search.tracks %}
  {% for track in search.tracks %}
  <div hx-boost="true" id="{{ track.hash }}" tabindex="-1" class="track mb-2 px-1 {% if player.hash == track.hash %}active{% endif %} d-flex align-items-center justify-content-center shadow-none border-0" hx-get="{{ uri("player.play", [track.hash]) }}" hx-swap="none">
    <a class="text-decoration-none" href="{{ uri("album.index", [track.album_hash]) }}" hx-target="#view" hx-select="#view" hx-swap="outerHTML" onclick="event.stopPropagation()"><img title="{{ track.album }}" class="cover me-2" src="{{ track.cover }}" /></a>
    <div class="d-flex flex-column flex-grow-1 truncate" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      <span title="{{ track.title }}" class="title truncate {% if player.hash == track.hash %}active{% endif %}">{{ track.title}}</span>
      <span title="{{ track.artist }}" class="artist small truncate {% if player.hash == track.hash %}active{% endif %}"><a class="text-reset text-decoration-none" href="{{ uri("artist.index", [track.artist_hash]) }}" onclick="event.stopPropagation()">{{ track.artist}}</a></span>
    </div>
    <span class="playtime-string pe-2">{{ track.playtime_string }}</span>
  </div>
  {% endfor %}
{% else %}
  <div class="p-2">
    {% if search.term %}
      <p class="lead"><i class="bi bi-info text-warning pe-1"></i> No results found for '{{ search.term }}'</p>
    {% else %}
      <p class="lead"><i class="bi bi-star-fill text-warning pe-1"></i> Search for tracks, albums, and artists!</p>
    {% endif %}
  </div>
{% endif %}
