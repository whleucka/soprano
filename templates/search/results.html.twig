{% if search.tracks %}
  {% for track in search.tracks %}
    {% embed 'components/track-row.html.twig' with {
      track: track,
      play_uri: uri('player.play', [track.hash])
    } %}
      {% block leading %}
        <img title="{{ track.album }}" class="cover me-2" src="{{ track.cover }}" loading="lazy"/>
      {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <div class="p-2">
    {% if search.term %}
      <p class="lead"><i class="bi bi-info text-warning pe-1"></i> No results found for '{{ search.term }}'</p>
    {% else %}
      <p class="lead"><i class="bi bi-star-fill text-warning pe-1"></i> Search for tracks, albums, and artists!</p>
    {% endif %}
  </div>
{% endif %}
