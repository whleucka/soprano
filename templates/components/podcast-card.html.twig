<div class="d-flex flex-column album-cont radio-cont">
  <div class="cover-wrap position-relative">
    <a hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" href="{{ uri('podcasts.show', [p.hash]) }}">
      <img title="{{ p.title }}" class="cover" src="{{ p.thumbnail }}" loading="lazy" style="cursor: pointer;" />
    </a>
    <div class="card-actions d-flex align-items-center">
      <span class="like-overlay"
            hx-get="{{ uri('podcasts.like', [p.hash]) }}"
            hx-trigger="like-{{ p.hash }} from:body">
        {% include 'components/like-btn.html.twig' with { liked: p.liked, like_uri: uri('podcasts.like-toggle', [p.hash]) } %}
      </span>
    </div>
  </div>
  <span title="{{ p.title }}" class="title truncate fw-bold mt-1">{{ p.title }}</span>
  {% if p.publisher %}
    <span title="{{ p.publisher }}" class="artist small truncate"><i class="bi bi-mic pe-1"></i> {{ p.publisher }}</span>
  {% endif %}
</div>
