{# Most feeds identify the current row by hash against the player state the
   controller passed in. The queue can't: it is index-addressed (the same track
   can sit in it twice) and it renders without `player`, which used to make
   this test silently null and left the queue with no highlight at all until
   something in JS put one there. Callers that know better pass `active`. #}
{% set is_active = active is defined ? active : track.hash == player.hash %}
<div id="{{ dom_id|default(track.hash) }}" tabindex="-1"
     class="track p-1 {% if is_active %}active{% endif %} d-flex align-items-center justify-content-center shadow-none border-0">
  {% block first %}
    <div hx-get="{{ uri('track.like', [track.hash]) }}" hx-trigger="like-{{ track.hash }} from:body">
      {% include 'components/like-btn.html.twig' with { liked: track.liked, like_uri: uri('track.like-toggle', [track.hash]) } %}
    </div>
  {% endblock %}
  <div class="d-flex align-items-center flex-grow-1 truncate"
       hx-get="{{ play_uri }}" hx-swap="none">
    {% block leading %}{% endblock %}
    <div class="d-flex flex-column flex-grow-1 truncate">
      <span title="{{ track.title }}" class="title truncate">{{ track.title }}</span>
      {% block subtitle %}
        <span title="{{ track.artist }}" class="artist small truncate">{{ track.artist }}</span>
      {% endblock %}
      {# Opt-in third line. Empty by default: only the feed lists have history
         on the row worth showing, and an album or playlist track list would
         gain a blank line for nothing. #}
      {% block meta %}{% endblock %}
    </div>
  </div>
  <div class="dropdown">
    {% set ddid = track.hash ~ '-' ~ (dropdown_suffix|default('dropdown')) %}
    <button class="btn dropdown-toggle" type="button" id="{{ ddid }}"
            data-bs-toggle="dropdown" aria-expanded="false">
      {% block trailing %}
        <span class="playtime-string">{{ track.playtime_string }}</span>
      {% endblock %}
    </button>
    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="{{ ddid }}"
        hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      {% block menu %}
        <li><a class="dropdown-item" href="{{ uri('track.index', [track.hash]) }}" {% if link_before_request|default(null) %}hx-on::before-request="{{ link_before_request }}"{% endif %}><i class="bi bi-music-note pe-1"></i> {{ track.title }}</a></li>
        <li><a class="dropdown-item" href="{{ uri('artist.index', [track.artist_hash]) }}" {% if link_before_request|default(null) %}hx-on::before-request="{{ link_before_request }}"{% endif %}><i class="bi bi-person pe-1"></i> {{ track.artist }}</a></li>
        <li><a class="dropdown-item" href="{{ uri('album.index', [track.album_hash]) }}" {% if link_before_request|default(null) %}hx-on::before-request="{{ link_before_request }}"{% endif %}><i class="bi bi-disc pe-1"></i> {{ track.album }}</a></li>
      {% endblock %}
      <li><hr class="dropdown-divider"></li>
      {% block queue_actions %}
        <li><a class="dropdown-item" style="cursor: pointer;" hx-get="{{ uri('playlist.queue-next', [track.hash]) }}" hx-swap="none"><i class="bi bi-arrow-return-right pe-1"></i> Play next</a></li>
        <li><a class="dropdown-item" style="cursor: pointer;" hx-get="{{ uri('playlist.queue-last', [track.hash]) }}" hx-swap="none"><i class="bi bi-plus-square pe-1"></i> Add to queue</a></li>
      {% endblock %}
      <li><a class="dropdown-item" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#modal"
             hx-get="{{ uri('playlists.modal') }}?src=track&ref={{ track.hash }}" hx-target="#modal .modal-content" hx-swap="innerHTML" hx-select="#modal-picker"><i class="bi bi-music-note-list pe-1"></i> Add to playlist</a></li>
    </ul>
  </div>
</div>
