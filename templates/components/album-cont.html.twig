<div class="d-flex flex-column album-cont" hx-push-url="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
  <div class="cover-wrap position-relative">
    <img title="{{ track.artist }} - {{ track.album }}" hx-get="{{ uri("album.index", [track.album_hash]) }}" class="cover" src="{{ track.cover }}" loading="lazy" />
    {% block badge %}
    {% endblock %}
  </div>
  <span title="{{ track.title }}" class="title truncate fw-bold mt-1">{{ track.title }}</span>
  <span title="{{ track.artist }}" class="artist small truncate"><a hx-boost="true" class="text-reset text-decoration-none" href="{{ uri("artist.index", [track.artist_hash]) }}"><i class="bi bi-person pe-1"></i> {{ track.artist }}</a></span>
  {% block extra %}
  {% endblock %}
</div>
