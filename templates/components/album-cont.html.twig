<div class="d-flex flex-column album-cont" hx-push-url="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
  <div class="cover-wrap position-relative">
    <img title="{{ track.artist }} - {{ track.album }}" hx-get="{{ uri("album.index", [track.album_hash]) }}" class="cover" src="{{ track.cover }}" loading="lazy" />
    {% block badge %}
    {% endblock %}
  </div>
  {% block extra %}
    <span title="{{ track.album }}" class="title truncate fw-bold mt-1">{{ track.album }}</span>
    <span title="{{ track.artist }}" class="artist small truncate"><i class="bi bi-person pe-1"></i> {{ track.artist }}</span>
  {% endblock %}
</div>
