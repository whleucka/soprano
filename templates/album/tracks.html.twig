{% for track in tracks %}
  {% embed 'components/track-row.html.twig' with {
    track: track,
    play_uri: uri('player.play-album-track', [album_hash, loop.index0])
  } %}
    {% block leading %}
      <span class="track-number text-end me-3">{% if track.track_number %}{{ track.track_number }}{% else %}#{% endif %}</span>
    {% endblock %}
    {% block subtitle %}{% endblock %}
    {% block menu %}
      <li><a class="dropdown-item" href="{{ uri('artist.index', [track.artist_hash]) }}">{{ track.artist }}</a></li>
    {% endblock %}
  {% endembed %}
{% endfor %}
