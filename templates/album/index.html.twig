{% extends "layout/app.html.twig" %}

{% block title %}Soprano - {{ album }} {% endblock %}

{% block view %}
<section id="album" class="h-100 d-flex flex-column">
  <div class="hero d-flex flex-column justify-content-center p-3"{% if dominant %} style="background: linear-gradient(180deg, rgba({{ dominant[0] }}, {{ dominant[1] }}, {{ dominant[2] }}, 0.5) 0%, rgba(0, 0, 0, 0) 100%);"{% endif %}>
    <div class="d-flex flex-column truncate">
      <div class="d-flex align-items-start truncate">
        <img class="cover me-3" src="{{ cover }}" />
        <div class="d-flex flex-column truncate">
          <h1 title="{{ album }}" class="album truncate">{{ album }}</h1>
          <h2 class="artist"><a class="text-reset text-decoration-none" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" href="{{ uri("artist.index", [artist_hash]) }}">{{ artist }}{% if year %} &middot; {{ year }}{% endif %}</a></h2>
        </div>
      </div>
      <div class="actions d-flex flex-nowrap align-items-center gap-2 mt-3" hx-get="{{ uri("album.actions", [album_hash]) }}" hx-trigger="load, albumActions from:body"></div>
    </div>
  </div>
  <div class="tracks scrollable" hx-get="{{ uri('album.tracks', [album_hash]) }}" hx-trigger="load, albumTracks from:body">{% include 'components/skeleton-rows.html.twig' with { subtitle: false } %}</div>
</section>
{% endblock %}
