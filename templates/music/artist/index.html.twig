{% extends "layout/app.html.twig" %}

{% block title %}Soprano - {{ artist }} {% endblock %}

{% block view %}
<section id="artist" class="h-100 d-flex flex-column">
  <div class="hero d-flex align-items-center p-3">
    <div class="d-flex align-items-center">
      <img class="cover me-3" src="/images/no-album-art.png" />
      <div class="d-flex flex-column">
        <h1 class="artist">{{ artist }}</h1>
      </div>
    </div>
  </div>
  <div id="actions" class="d-flex">
  </div>
  <div class="p-3 scrollable">
    <h2>Top Tracks</h2>
    <section id="top-tracks" class="placeholder-glow pb-3" hx-get="{{ uri("music.artist.top-tracks", [hash]) }}" hx-trigger="load, topTracks from:body">
      <ol class="top-tracks list-unstyled m-0">
        <li class="top-track d-flex align-items-center py-2">
          <span class="rank text-muted me-3">1</span>
          <div class="thumb placeholder me-3"></div>
          <div class="flex-grow-1"><span class="placeholder col-6"></span></div>
        </li>
        <li class="top-track d-flex align-items-center py-2">
          <span class="rank text-muted me-3">2</span>
          <div class="thumb placeholder me-3"></div>
          <div class="flex-grow-1"><span class="placeholder col-5"></span></div>
        </li>
        <li class="top-track d-flex align-items-center py-2">
          <span class="rank text-muted me-3">3</span>
          <div class="thumb placeholder me-3"></div>
          <div class="flex-grow-1"><span class="placeholder col-7"></span></div>
        </li>
      </ol>
    </section>

    <h2 class="mt-3">Discography</h2>
    <section id="discography" class="d-flex justify-content-start placeholder-glow pb-3" hx-get="{{ uri("music.artist.discography", [hash]) }}" hx-trigger="load">
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
    </section>
  </div>
</section>
{% endblock %}
