{% if tracks %}
  {% for track in tracks %}
    <div class="d-flex flex-column recent" hx-push-url="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      <img title="{{ track.album }}" hx-get="{{ uri("music.album", [track.album_hash]) }}" class="cover" src="{{ track.cover }}" />
      <span title="{{ track.album }}" class="info album truncate fw-bold mt-1"><a hx-boost="true" class="text-reset text-decoration-none" href="{{ uri("music.album", [track.album_hash]) }}">{{ track.album }}</a></span>
      <span title="{{ track.year }}" class="info year truncate">{{ track.year }}</span>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No albums found for this artist</p>
{% endif %}
