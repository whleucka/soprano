{% if items %}
  {% for item in items %}
    <div class="d-flex flex-column recent" hx-push-url="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      <img title="{{ item.album }}" hx-get="{{ uri("music.album", [item.hash]) }}" class="cover" src="{{ item.cover }}" />
      <span title="{{ item.album }}" class="info truncate fw-bold mt-1"><a hx-boost="true" class="text-decoration-none" href="{{ uri("music.album", [item.hash]) }}">{{ item.album }}</a></span>
      <span title="{{ item.year }}" class="info truncate">{{ item.year }}</span>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No albums found for this artist</p>
{% endif %}
