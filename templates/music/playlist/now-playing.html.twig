<div class="d-flex justify-content-center my-1">
  <img id="cover" src="{{ player.cover }}" />
</div>
<div class="d-flex flex-column truncate" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
  <h1 id="title" class="m-0 truncate">{{ player.title }}</h1>
  <h3 id="artist" class="truncate"><a class="text-decoration-none" href="{{ uri("music.artist", [player.hash]) }}"><i class="bi bi-person pe-1"></i> {{ player.artist }}</a></h3>
  <h3 id="album" class="truncate"><a class="text-decoration-none" href="{{ uri("music.album", [player.hash]) }}"><i class="bi bi-disc pe-1"></i> {{ player.album }}</a></h3>
</div>
