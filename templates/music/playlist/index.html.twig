<section id="now-playing" class="d-flex flex-column" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
  <div class="p-3">
    <a class="text-decoration-none" href="{{ uri("music.album", [player.hash]) }}"><h5 class="text-light"><i class="bi bi-disc pe-1"></i> {{ player.album }}</h5></a>
  </div>
  <div class="d-flex justify-content-center">
    <img src="{{ player.cover }}" />
  </div>
  <div class="d-flex flex-column p-3">
    <h1>{{ player.title }}</h1>
    <a class="text-decoration-none" href="{{ uri("music.artist", [player.hash]) }}"><h3><i class="bi bi-person pe-1"></i> {{ player.artist }}</h3></a>
  </div>
</section>
<section id="queue" class="p-3 scrollable" hx-on::load="scrollPlaylistToActive()">
  <div id="tracks">
    {% if playlist.tracks %}
      {% for track in playlist.tracks %}
      <div id="playlist-{{ track.hash }}" tabindex="-1" class="track {% if player.hash == track.hash %}active{% endif %} d-flex align-items-center shadow-none border-0" hx-get="{{ uri("music.play-playlist-track", [loop.index0]) }}" hx-swap="none">
        <div class="d-flex flex-column flex-grow-1 truncate">
          <span class="title truncate">{{ track.title}}</span>
          <span class="artist truncate">{{ track.artist}}</span>
        </div>
        <span class="playtime-string pe-2">{{ track.playtime_string }}</span>
      </div>
      {% endfor %}
    {% else %}
      <p class="lead">Playlist is empty</p>
    {% endif %}
  </div>
</section>
<script>
window.scrollPlaylistToActive = function () {
  var queue = document.getElementById("queue");
  if (!queue || !queue.offsetParent) return; // hidden — skip
  var active = queue.querySelector(".track.active");
  if (!active) return;
  requestAnimationFrame(function () {
    var queueRect = queue.getBoundingClientRect();
    var activeRect = active.getBoundingClientRect();
    var delta = (activeRect.top - queueRect.top) - (queue.clientHeight / 2) + (active.clientHeight / 2);
    queue.scrollTop += delta;
  });
};
window.scrollPlaylistToActive();
</script>
