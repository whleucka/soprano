<div class="p-3 d-flex flex-column h-100" style="min-height: 0;">
  <section id="now-playing" class="d-flex flex-column" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
    <div class="d-flex justify-content-center my-1">
      <img id="cover" src="{{ player.cover }}" />
    </div>
    <div class="d-flex flex-column truncate">
      <h1 id="title" class="m-0 truncate">{{ player.title }}</h1>
      <h3 id="artist" class="truncate"><a class="text-decoration-none" href="{{ uri("music.artist", [player.hash]) }}"><i class="bi bi-person pe-1"></i> {{ player.artist }}</a></h3>
      <h3 id="album" class="truncate"><a class="text-decoration-none" href="{{ uri("music.album", [player.hash]) }}"><i class="bi bi-disc pe-1"></i> {{ player.album }}</a></h3>
    </div>
  </section>
  <hr>
  <section id="queue" class="scrollable mt-2" hx-on::load="scrollPlaylistToActive()">
    <div id="tracks">
      {% if playlist.tracks %}
        {% for track in playlist.tracks %}
        <div id="playlist-{{ track.hash }}" tabindex="-1" class="track py-2 {% if player.hash == track.hash %}active{% endif %} d-flex align-items-center shadow-none border-0" hx-get="{{ uri("music.play-playlist-track", [loop.index0]) }}" hx-swap="none">
          <div class="d-flex flex-column flex-grow-1 truncate">
            <span class="title truncate pe-1 {% if player.hash == track.hash %}active{% endif %}">{{ track.title}}</span>
            <span class="artist truncate pe-1 {% if player.hash == track.hash %}active{% endif %}">{{ track.artist}}</span>
          </div>
          <span class="playtime-string pe-2">{{ track.playtime_string }}</span>
        </div>
        {% endfor %}
      {% else %}
        <p class="lead">Playlist is empty</p>
      {% endif %}
    </div>
  </section>
</div>
<script>
window.scrollPlaylistToActive = function () {
  var queue = document.getElementById("queue");
  if (!queue || !queue.offsetParent) return; // hidden — skip
  var active = queue.querySelector(".track.active");
  if (!active) return;
  requestAnimationFrame(function () {
    var queueRect = queue.getBoundingClientRect();
    var activeRect = active.getBoundingClientRect();
    var delta = (activeRect.top - queueRect.top) - (queue.clientHeight / 2) + (active.clientHeight / 2);
    queue.scrollTop += delta;
  });
};
window.scrollPlaylistToActive();
</script>
