{% if items %}
  {% for item in items %}
    <div class="d-flex flex-column recent" hx-push-url="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      <img title="{{item.artist}} - {{item.album}}" hx-get="{{ uri("music.album", [item.hash]) }}"  class="cover" src="{{ item.cover }}" />
      <span title="{{ item.title }}" class="info truncate fw-bold mt-1">{{ item.title }}</span>
      <span title="{{ item.artist }}" class="info truncate"><a hx-boost="true" class="text-reset text-decoration-none" href="{{ uri("music.artist", [item.hash]) }}">{{ item.artist }}</a></span>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No music has been played recently</p>
{% endif %}

