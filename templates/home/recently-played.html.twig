{% if tracks %}
  {% for track in tracks %}
    {% set info = [] %}
    {% if track.ago %}
      {% set info = info|merge([{ icon: 'bi-clock-history', text: 'Played ' ~ track.ago }]) %}
    {% endif %}
    {% if track.client %}
      {% set info = info|merge([{ icon: 'bi-person-circle', text: track.client }]) %}
    {% endif %}
    {% embed 'components/album-cont.html.twig' with {
      track: track,
      play_src: 'recently-played',
      menu_id: 'rp',
      info: info,
    } %}
    {% block badge %}
      {% if track.client or track.ago %}
        {# No title — the badge is pointer-events:none so the cover stays
           clickable, and the card menu already spells out both facts. #}
        <span class="played-badge">
          <i class="bi bi-clock-history pe-1"></i>
          {% if track.client %}<span class="played-by truncate">{{ track.client }}</span>{% endif %}
          {% if track.client and track.ago_short %}<span class="sep">&middot;</span>{% endif %}
          {% if track.ago_short %}<span class="ago">{{ track.ago_short }}</span>{% endif %}
        </span>
      {% endif %}
    {% endblock %}
    {% block extra %}
      <span title="{{ track.title }}" class="title truncate fw-bold mt-1">{{ track.title }}</span>
      <span title="{{ track.artist }}" class="artist small truncate"><i class="bi bi-person pe-1"></i> {{ track.artist }}</span>
      <span title="{{ track.album }}" class="album small truncate"><i class="bi bi-disc pe-1"></i> {{ track.album }}</span>
    {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No music has been played recently</p>
{% endif %}
