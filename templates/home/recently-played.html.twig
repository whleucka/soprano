{% if tracks %}
  {% for track in tracks %}
    {% embed 'components/album-cont.html.twig' with {
      track: track,
    } %}
    {% block extra %}
      <span title="{{ track.title }}" class="title truncate fw-bold mt-1">{{ track.title }}</span>
      <span title="{{ track.artist }}" class="artist small truncate"><i class="bi bi-person pe-1"></i> {{ track.artist }}</span>
      <span title="{{ track.client }}" class="client truncate"><i class="bi bi-person-circle pe-1"></i> {{ track.client ?? 'unknown' }}</span>
    {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No music has been played recently</p>
{% endif %}
