{% extends "layout/app.html.twig" %}

{% block title %}Soprano - Home{% endblock %}

{% block view %}
<section id="home" class="h-100 d-flex flex-column">
  <div class="hero d-flex align-items-center p-3">
    <h1><i class="bi bi-house pe-1"></i> Home</h1>
  </div>
  <div class="p-3 scrollable">
    <h2>Recently Played</h2>
    <section id="recently-played" class="d-flex justify-content-start placeholder-glow pb-3" hx-get="{{ uri("home.recently-played") }}" hx-trigger="load, recentlyPlayed from:body">
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
    </section>

    <h2 class="mt-3">Top Played</h2>
    <section id="top-played" class="d-flex justify-content-start placeholder-glow pb-3" hx-get="{{ uri("home.top-played") }}" hx-trigger="load, topPlayed from:body">
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
    </section>

    <h2 class="mt-3">Recently Added</h2>
    <section id="recently-added" class="d-flex justify-content-start placeholder-glow pb-3" hx-get="{{ uri("home.recently-added") }}" hx-trigger="load, recentlyAdded from:body">
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
      <div class="d-flex flex-column recent">
        <div class="cover placeholder"></div>
      </div>
    </section>
  </div>
</section>
{% endblock %}
