{% set slot_icons = {
  'heavy-rotation': 'bi-fire text-danger',
  'morning-mix':    'bi-sunrise text-warning',
  'evening-mix':    'bi-moon-stars text-info',
  'time-machine':   'bi-hourglass-split text-secondary',
  'rediscover':     'bi-compass text-success',
  'fresh-arrivals': 'bi-stars text-warning',
} %}
{% if playlists %}
  {% for p in playlists %}
    <div class="d-flex flex-column album-cont" hx-boost="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML" style="cursor: pointer;">
      <div class="cover-wrap position-relative">
        <a href="{{ uri('playlists.show', [p.hash]) }}">
          <img title="{{ p.name }}" class="cover" src="{{ p.cover }}" loading="lazy" />
        </a>
      </div>
      <span title="{{ p.name }}" class="title truncate fw-bold mt-1"><i class="bi {{ slot_icons[p.slot]|default('bi-stars text-warning') }} pe-1"></i>{{ p.name }}</span>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No mixes yet — they appear once you've listened for a while</p>
{% endif %}
