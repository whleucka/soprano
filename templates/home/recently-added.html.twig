{% if items %}
  {% for item in items %}
    <div class="d-flex flex-column recent">
      <img class="cover" src="{{ item.cover }}" />
      <span class="album truncate">{{ item.album }}</span>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No music has been added recently</p>
{% endif %}
