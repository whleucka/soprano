{% if items %}
  {% for item in items %}
    <div class="d-flex flex-column recent" title="{{item.artist}} - {{item.album}}" hx-push-url="true" hx-get="{{ uri("music.album", [item.hash]) }}" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      <img class="cover" src="{{ item.cover }}" />
      <span class="info truncate">{{ item.album }}</span>
      <span class="info truncate">{{ item.artist }}</span>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No music has been added recently</p>
{% endif %}
