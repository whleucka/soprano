{% if items %}
  {% for item in items %}
    <div class="d-flex flex-column recent" hx-push-url="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      <img title="{{item.artist}} - {{item.album}}"  hx-get="{{ uri("music.album", [item.hash]) }}"  class="cover" src="{{ item.cover }}" />
      <div title="{{ item.album }}" class="info truncate fw-bold mt-1"><a hx-boost="true" class="text-decoration-none" href="{{ uri("music.album", [item.hash]) }}"><span>{{ item.album }}</span></a></div>
      <div title="{{ item.artist }}" class="info truncate"><a hx-boost="true" class="text-decoration-none" href="{{ uri("music.artist", [item.hash]) }}"><span>{{ item.artist }}</span></a></div>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No music has been added recently</p>
{% endif %}
