{% if items %}
  {% for item in items %}
    <div class="d-flex flex-column album-cont" hx-push-url="true" hx-target="#view" hx-select="#view" hx-swap="outerHTML">
      <img title="{{ item.artist }} - {{ item.album }}" hx-get="{{ uri("album.index", [item.album_hash]) }}" class="cover" src="{{ item.cover }}" />
      <span title="{{ item.album }}" class="title truncate fw-bold mt-1"><a hx-boost="true" class="text-reset text-decoration-none" href="{{ uri("album.index", [item.album_hash]) }}">{{ item.album }}</a></span>
      <span title="{{ item.artist }}" class="artist small truncate"><a hx-boost="true" class="text-reset text-decoration-none" href="{{ uri("artist.index", [item.artist_hash]) }}">{{ item.artist }}</a></span>
    </div>
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> No music has been added recently</p>
{% endif %}
