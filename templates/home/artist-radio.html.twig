{% if artists %}
  <div class="d-inline-flex align-items-center gap-2">
    <h2 class="mb-0"><i class="bi bi-broadcast text-success pe-1"></i> Artist Radio</h2>
  </div>
  <div class="d-flex justify-content-start gap-3 py-2 scrollable">
    {% for a in artists %}
      <button class="btn btn-dark d-flex flex-column align-items-center p-2 border-0 bg-transparent"
              hx-get="{{ uri('player.play-artist-radio', [a.hash]) }}" hx-swap="none"
              title="Start radio from {{ a.name }}" style="width: 8rem;">
        <span class="position-relative d-inline-block">
          <img class="rounded-circle d-block" src="{{ a.image|default('/images/no-album-art.png') }}"
               alt="{{ a.name }}" loading="lazy"
               style="width: 7rem; height: 7rem; object-fit: cover;">
          <span class="position-absolute d-inline-flex align-items-center justify-content-center rounded-circle text-bg-success border border-2 border-dark"
                style="width: 1.9rem; height: 1.9rem; bottom: .1rem; right: .1rem;">
            <i class="bi bi-broadcast" style="font-size: .8rem;"></i>
          </span>
        </span>
        <span class="small fw-bold text-nowrap text-truncate mt-2 w-100 text-center">{{ a.name }}</span>
      </button>
    {% endfor %}
  </div>
{% endif %}
