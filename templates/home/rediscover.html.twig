{% if tracks %}
  {% for track in tracks %}
    {% embed 'components/album-cont.html.twig' with {
      track: track,
      play_src: 'rediscover',
      menu_id: 'rd',
      info: track.ago ? [{ icon: 'bi-clock-history', text: 'Last played ' ~ track.ago }] : [],
    } %}
    {% block badge %}
      <span class="play-count-badge" title="{{ track.plays }} plays"><i class="bi bi-play-fill pe-1"></i>{{ track.plays }}</span>
    {% endblock %}
    {% block extra %}
      <span title="{{ track.title }}" class="title truncate fw-bold mt-1">{{ track.title }}</span>
      <span title="{{ track.artist }}" class="artist small truncate"><i class="bi bi-person pe-1"></i> {{ track.artist }}</span>
      <span title="{{ track.album }}" class="album small truncate"><i class="bi bi-disc pe-1"></i> {{ track.album }}</span>
    {% endblock %}
    {% endembed %}
  {% endfor %}
{% else %}
  <p class="lead"><i class="bi bi-info pe-1 text-warning"></i> Nothing to rediscover yet</p>
{% endif %}
