<div class="load-more-row w-100 d-flex justify-content-center my-3">
  <button class="btn btn-outline-light"
          hx-get="{{ uri('podcasts.search') }}?q={{ query|url_encode }}&offset={{ offset }}"
          hx-target="closest .load-more-row"
          hx-swap="outerHTML">
    <i class="bi bi-arrow-down-circle pe-1"></i> Load more
  </button>
</div>
