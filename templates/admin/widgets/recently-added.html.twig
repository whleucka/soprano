<div class="col-12 col-lg-{{ widget.width }} mb-4" id="widget-{{ widget.id }}"
  {% if widget.refresh_interval > 0 %}
  hx-get="{{ uri('dashboard.widgets.render', {id: widget.id}) }}"
  hx-trigger="every {{ widget.refresh_interval }}s"
  hx-swap="outerHTML"
  {% endif %}>
  <div class="card shad border-0 h-100">
    <div class="card-header border-0 d-flex justify-content-between align-items-center">
      <span><i class="bi bi-{{ widget.icon }} me-2"></i>{{ widget.title }}</span>
      <button class="btn btn-sm btn-outline-secondary"
        hx-get="{{ uri('dashboard.widgets.render', {id: widget.id}) }}"
        hx-swap="outerHTML"
        hx-target="#widget-{{ widget.id }}">
        <i class="bi bi-arrow-clockwise"></i>
      </button>
    </div>
    <div class="card-body">
      {% if data.tracks|length > 0 %}
      <div class="table-responsive" style="max-height: 260px;">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Title</th>
              <th>Artist</th>
              <th class="text-end">Added</th>
            </tr>
          </thead>
          <tbody>
            {% for track in data.tracks %}
            <tr>
              <td class="text-truncate" style="max-width: 150px;">{{ track.title ?: 'Unknown' }}</td>
              <td class="text-truncate text-muted" style="max-width: 130px;">{{ track.artist ?: 'Unknown' }}</td>
              <td class="text-end text-muted small">{{ track.time_ago }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <p class="text-muted text-center mb-0">No tracks found</p>
      {% endif %}
    </div>
    <div class="card-footer border-0">
      <a href="/tracks" hx-boost="true" hx-target="#module" hx-select="#module" hx-swap="outerHTML" hx-push-url="true" class="text-muted small">
        <i class="bi bi-arrow-right me-1"></i>View all tracks
      </a>
    </div>
  </div>
</div>
