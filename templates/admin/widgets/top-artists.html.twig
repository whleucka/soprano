<div class="col-12 col-lg-{{ widget.width }} mb-4" id="widget-{{ widget.id }}"
  {% if widget.refresh_interval > 0 %}
  hx-get="{{ uri('dashboard.widgets.render', {id: widget.id}) }}"
  hx-trigger="every {{ widget.refresh_interval }}s"
  hx-swap="outerHTML"
  {% endif %}>
  <div class="card shad border-0 h-100">
    <div class="card-header border-0 d-flex justify-content-between align-items-center">
      <span><i class="bi bi-{{ widget.icon }} me-2"></i>{{ widget.title }}</span>
      <button class="btn btn-sm btn-outline-secondary"
        hx-get="{{ uri('dashboard.widgets.render', {id: widget.id}) }}"
        hx-swap="outerHTML"
        hx-target="#widget-{{ widget.id }}">
        <i class="bi bi-arrow-clockwise"></i>
      </button>
    </div>
    <div class="card-body">
      {% if data.artists|length > 0 %}
      <ul class="list-group list-group-flush" style="max-height: 260px; overflow-y: auto;">
        {% for artist in data.artists %}
        <li class="list-group-item d-flex align-items-center px-0">
          <span class="text-muted me-2" style="width: 1.25rem;">{{ loop.index }}</span>
          {% if artist.image %}
          <img src="{{ artist.image }}" alt="" loading="lazy" class="rounded me-2" style="width: 36px; height: 36px; object-fit: cover;">
          {% else %}
          <span class="bg-info bg-opacity-10 rounded d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
            <i class="bi bi-person-circle text-info"></i>
          </span>
          {% endif %}
          <span class="flex-grow-1 text-truncate">{{ artist.artist ?: 'Unknown' }}</span>
          <span class="badge bg-secondary bg-opacity-75">{{ artist.plays|number_format }}</span>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="text-muted text-center mb-0">No plays recorded yet</p>
      {% endif %}
    </div>
    <div class="card-footer border-0">
      <a href="/artists" hx-boost="true" hx-target="#module" hx-select="#module" hx-swap="outerHTML" hx-push-url="true" class="text-muted small">
        <i class="bi bi-arrow-right me-1"></i>View all artists
      </a>
    </div>
  </div>
</div>
