<div class="col-12 col-lg-{{ widget.width }} mb-4" id="widget-{{ widget.id }}"
  {% if widget.refresh_interval > 0 %}
  hx-get="{{ uri('dashboard.widgets.render', {id: widget.id}) }}"
  hx-trigger="every {{ widget.refresh_interval }}s"
  hx-swap="outerHTML"
  {% endif %}>
  <div class="card shad border-0 h-100">
    <div class="card-header border-0 d-flex justify-content-between align-items-center">
      <span><i class="bi bi-{{ widget.icon }} me-2"></i>{{ widget.title }}</span>
      <button class="btn btn-sm btn-outline-secondary"
        hx-get="{{ uri('dashboard.widgets.render', {id: widget.id}) }}"
        hx-swap="outerHTML"
        hx-target="#widget-{{ widget.id }}">
        <i class="bi bi-arrow-clockwise"></i>
      </button>
    </div>
    <div class="card-body">
      <div class="chart-container">
        <canvas id="chart-{{ widget.id }}"></canvas>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  var chartId = 'chart-{{ widget.id }}';
  var options = {{ data.options|raw }};

  var existing = Chart.getChart(chartId);
  if (existing) existing.destroy();

  requestAnimationFrame(function() {
    var canvas = document.getElementById(chartId);
    if (canvas) {
      new Chart(canvas, options);
    }
  });
})();
</script>
