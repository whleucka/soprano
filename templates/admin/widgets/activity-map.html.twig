{#
  Hidden below md: a world map in a phone-width column is a smear. The
  underlying numbers are in the strip, so nothing is lost on mobile.
#}
{% embed 'admin/widgets/card.html.twig' %}
  {% block body %}
    <div class="dash-facts mb-2">
      <span><strong>{{ data.total|number_format }}</strong> unique IPs</span>
      <span><strong>{{ data.country_count }}</strong> {{ data.country_count == 1 ? 'country' : 'countries' }}</span>
    </div>
    <div id="activity-world-map" class="dash-map d-none d-md-block"
      data-countries="{{ data.countries_json }}"
      data-max="{{ data.max }}"></div>
    {% if data.top is not empty %}
    <div class="dash-flags">
      {% for item in data.top %}
        <span class="dash-flag">{{ item.flag|raw }} {{ item.code }} <strong>{{ item.count }}</strong></span>
      {% endfor %}
    </div>
    {% endif %}
  {% endblock %}
{% endembed %}
