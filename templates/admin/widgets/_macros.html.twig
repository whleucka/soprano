{#
  Small pieces shared across the dashboard bands.

  Import these *inside* the block that calls them:
    {% block body %}
      {% import 'admin/widgets/_macros.html.twig' as ui %}
      ...
    {% endblock %}

  An import at the top of the file looks like it works and silently renders
  nothing inside an {% embed %}: the embed's blocks compile into a different
  template class, so the imported macro isn't in their scope. That cost every
  completion meter and every card footer on the first deploy.
#}

{#
  Sparkline, drawn as flexed bars rather than an SVG polyline or a Chart.js
  instance. Six KPI tiles would mean six canvases and six resize observers for
  something that has no axes, no tooltip and no legend; bars cost nothing, and
  they colour themselves from the theme through one CSS rule.

  Zero buckets keep a 3% stub so a quiet day reads as "nothing here" rather
  than as a gap in the chart.
#}
{% macro spark(values, tone) %}
  {% if values is not empty %}
    {% set top = max(values) %}
    <span class="spark spark-{{ tone|default('accent') }}" aria-hidden="true">
      {% for v in values|slice(-30) %}
        <i style="height: {{ top > 0 ? max((v / top * 100)|round, 3) : 3 }}%"></i>
      {% endfor %}
    </span>
  {% endif %}
{% endmacro %}

{# Signed change against the previous window, arrow and colour by direction. #}
{% macro delta(d) %}
  {% if d %}
    <span class="dash-delta dash-delta-{{ d.direction }}">
      <i class="bi bi-{{ d.direction == 'up' ? 'arrow-up' : (d.direction == 'down' ? 'arrow-down' : 'dash') }}"></i>{{ d.text }}
    </span>
  {% endif %}
{% endmacro %}

{#
  Completion rate as a filled meter. `null` means nothing in this window was
  ever finalised — which is not the same as 0%, and must not look like it.
#}
{% macro meter(percent, tone) %}
  {% if percent is null %}
    <span class="dash-meter-na" title="No completed plays reported">—</span>
  {% else %}
    <span class="dash-meter" title="{{ percent }}% listened through">
      <span class="dash-meter-fill dash-meter-{{ tone|default('muted') }}" style="width: {{ percent }}%"></span>
    </span>
  {% endif %}
{% endmacro %}

{# Footer link into the module that owns the detail. #}
{% macro module_link(href, label) %}
  <div class="card-footer dash-card-footer">
    <a href="{{ href }}" class="dash-footer-link"
      hx-boost="true" hx-target="#module" hx-select="#module"
      hx-swap="outerHTML" hx-push-url="true">
      {{ label }}<i class="bi bi-arrow-right"></i>
    </a>
  </div>
{% endmacro %}
